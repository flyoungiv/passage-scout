# Optional: Demo works without keys. Never put credentials in frontend env vars.
TAVILY_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Server-issued access secret required for live calls from non-loopback clients.
LIVE_ACCESS_TOKEN=
# Published example limits, not guarantees or account-wide balances.
TAVILY_MONTHLY_CREDITS=1000
GROQ_REQUESTS_PER_MINUTE=30
GROQ_REQUESTS_PER_DAY=1000
GROQ_TOKENS_PER_MINUTE=8000
GROQ_TOKENS_PER_DAY=200000
# Optional OTLP/HTTP endpoint (base URL, without /v1/traces).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20REPLACE_LOCALLY

# For intentional remote hosting, add your hostname (JSON list).
ALLOWED_HOSTS=["localhost", "127.0.0.1", "[::1]"]
